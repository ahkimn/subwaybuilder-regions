{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.subwaybuilder-modded.dev/regions/manifest.schema.json",
  "title": "Regions map manifest",
  "description": "Contents of .railyard_map/regions/manifest.json.",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "cityCode": {
      "type": "string",
      "minLength": 1
    },
    "country": {
      "type": "string",
      "minLength": 1
    },
    "datasets": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "datasetId": {
            "type": "string",
            "minLength": 1
          },
          "displayName": {
            "type": "string",
            "minLength": 1
          },
          "unitSingular": {
            "type": "string",
            "minLength": 1
          },
          "unitPlural": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "file": {
            "type": "string",
            "minLength": 1
          },
          "size": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "fileSizeMB": {
            "type": "number",
            "minimum": 0
          },
          "style": {
            "type": "object",
            "properties": {
              "light": {
                "type": "object",
                "properties": {
                  "fill": {
                    "type": "string",
                    "pattern": "^#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
                  },
                  "fillHover": {
                    "type": "string",
                    "pattern": "^#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
                  },
                  "fillOpacity": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "line": {
                    "type": "string",
                    "pattern": "^#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
                  },
                  "lineOpacity": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "label": {
                    "type": "string",
                    "pattern": "^#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
                  },
                  "labelHalo": {
                    "type": "string",
                    "pattern": "^#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
                  }
                },
                "additionalProperties": false
              },
              "dark": {
                "type": "object",
                "properties": {
                  "fill": {
                    "type": "string",
                    "pattern": "^#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
                  },
                  "fillHover": {
                    "type": "string",
                    "pattern": "^#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
                  },
                  "fillOpacity": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "line": {
                    "type": "string",
                    "pattern": "^#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
                  },
                  "lineOpacity": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "label": {
                    "type": "string",
                    "pattern": "^#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
                  },
                  "labelHalo": {
                    "type": "string",
                    "pattern": "^#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
                  }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          }
        },
        "required": [
          "datasetId",
          "displayName",
          "unitSingular",
          "unitPlural",
          "source",
          "file",
          "size"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "datasets"
  ],
  "additionalProperties": false
}
