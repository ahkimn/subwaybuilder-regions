{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.subwaybuilder-modded.dev/regions/manifest.schema.json",
  "title": "Regions map manifest",
  "description": "Contents of .railyard_map/regions/manifest.json.",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "cityCode": {
      "type": "string",
      "minLength": 1
    },
    "country": {
      "type": "string",
      "minLength": 1
    },
    "datasets": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "datasetId": {
            "type": "string",
            "minLength": 1
          },
          "displayName": {
            "type": "string",
            "minLength": 1
          },
          "unitSingular": {
            "type": "string",
            "minLength": 1
          },
          "unitPlural": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "file": {
            "type": "string",
            "minLength": 1
          },
          "size": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "fileSizeMB": {
            "type": "number",
            "minimum": 0
          },
          "country": {
            "type": "string",
            "minLength": 1
          },
          "order": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "datasetId",
          "displayName",
          "unitSingular",
          "unitPlural",
          "source",
          "file",
          "size"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "datasets"
  ],
  "additionalProperties": false
}
